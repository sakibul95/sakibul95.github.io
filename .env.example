# Copy this file to `.env.local` and adjust the values for your deployment.
# All variables are optional — the site ships with sensible defaults.

# Public origin — used for canonical links, sitemap, robots and Open Graph.
# ORIGIN ONLY: no trailing slash and no sub-path (the sub-path belongs in
# NEXT_PUBLIC_BASE_PATH below). Defaults to https://sakibul95.github.io in
# production builds. For CI, this is set in .github/workflows/deploy.yml —
# note that .gitignore excludes .env* so env files never reach the runner.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Sub-path prefix, only for GitHub Pages *project* sites served at
# username.github.io/<repo>. Leave unset for a user site (username.github.io)
# or a custom domain, both of which serve from the root. Must start with "/"
# and have no trailing slash, e.g. "/portfolio1". If this is wrong, every
# asset 404s.
# NEXT_PUBLIC_BASE_PATH=/portfolio1

# Contact details shown across the site.
NEXT_PUBLIC_NAME=Sakibul Islam
NEXT_PUBLIC_ROLE=Senior Software Engineer
NEXT_PUBLIC_EMAIL=sakibul95bubt@gmail.com
NEXT_PUBLIC_PHONE=+8801966113178
NEXT_PUBLIC_LOCATION=Dhaka, Bangladesh
NEXT_PUBLIC_AVAILABLE=true

# Social profile URLs.
NEXT_PUBLIC_GITHUB_URL=https://github.com/sakibul95
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/sakibul95
